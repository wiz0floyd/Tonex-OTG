<?xml version="1.0" encoding="utf-8"?>
<!--
  Backs the FileProvider used solely by dev.tonexotg.app.probe.ProbeActivity to hand a saved
  probe-log file to another app via ACTION_SEND (issue #25's "dump to a file instead of
  clipboard" fix — a full read/write test's log overflows the clipboard's transaction size
  limit). external-files-path matches Context.getExternalFilesDir(null), where the log is
  actually written.

  Issue #71: only reached on the API 26-28 fallback path now; API 29+ writes the log via
  MediaStore instead (Documents/tonex-logs/), whose own content:// Uri is used directly. See
  ProbeLogFile.create and the provider entry's comment in AndroidManifest.xml.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-files-path name="probe_logs" path="probe-logs/" />
</paths>
