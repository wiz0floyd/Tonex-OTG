<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Required for UsbManager/UsbDeviceConnection (S20 hardware probe, issue #25 —
      dev.tonexotg.app.probe). Not required="true" globally on <application>, since the rest of
      the app doesn't need it yet; declared here so the Play/APK installer can warn correctly on
      a device with no USB host support.
    -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!--
          Placeholder scaffold only (S10 / issue #15). Real screens land in S15-S19 once the
          design gate is signed off; this Activity exists solely to prove the AGP/Compose
          wiring assembles and runs.

          android:taskAffinity is explicit (and distinct from ProbeActivity's below) because both
          activities declare their own MAIN/LAUNCHER intent-filter, giving each its own icon in
          the app drawer — with neither activity overriding taskAffinity, both default to the
          SAME value (the application's package name), which puts them in the same task. That
          made the two launcher icons unreliable: opening one and then the other could resurface
          whichever task already existed instead of actually starting the newly-tapped Activity,
          so both icons could appear to open the same (first-launched) screen. Distinct
          affinities give each launcher icon its own task, so each reliably opens its own Activity.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity="${applicationId}.main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          ⚠️ DIAGNOSTIC-ONLY (S20 hardware probe, issue #25). Not part of the app's real
          navigation — see dev.tonexotg.app.probe's KDoc. A standalone launcher activity so the
          product owner can run it directly from the device's app drawer, separate from
          MainActivity, without any of this being wired into real screens (S16-S19).

          android:taskAffinity is distinct from MainActivity's — see MainActivity's own comment
          above for why an explicit, distinct affinity is required on every launcher activity.
        -->
        <activity
            android:name=".probe.ProbeActivity"
            android:label="Tonex Probe (Diagnostic)"
            android:exported="true"
            android:taskAffinity="${applicationId}.probe"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode">
            <!--
              configChanges above keeps a rotation (or keyboard/UI-mode change) from destroying
              and recreating this Activity mid-probe, which would cancel its CoroutineScope —
              see ProbeSession.runWriteTest's NonCancellable restore-write guard (issue #25,
              opus-reviewer-probe25 B1).
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Backs ProbeActivity's "Save & share log" button (issue #25): a full read/write test's
          log overflows ClipboardManager's Binder transaction limit, so it's written to a file
          under getExternalFilesDir(null) instead and handed to another app via a content:// Uri
          from this provider, per androidx's FileProvider requirement (a raw file:// Uri would
          throw FileUriExposedException on API 24+).
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.probelogprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/probe_log_file_paths" />
        </provider>
    </application>

</manifest>
